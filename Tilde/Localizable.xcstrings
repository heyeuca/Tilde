    "System" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟随系统"
          }
        }
      }
    },
    "The document is shown read-only to protect the original file. Copy text out of it, or convert the file to UTF-8 with another tool." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のファイルを保護するため、書類は読み出し専用で表示されています。テキストをコピーして使うか、別のツールでファイルを UTF-8 に変換してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 파일을 보호하기 위해 문서를 읽기 전용으로 표시합니다. 텍스트를 복사해 사용하거나, 다른 도구로 파일을 UTF-8로 변환하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为保护原始文件，文稿以只读方式显示。请从中复制文本，或使用其他工具将文件转换为 UTF-8。"
          }
        }
      }
    },
    "This file isn't a text file." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはテキストファイルではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일은 텍스트 파일이 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件不是文本文件。"
          }
        }
      }
    },
    "This file uses an encoding Tilde can't fully read, so saving would corrupt it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは Tilde が完全には読み取れないエンコーディングを使用しているため、保存するとファイルが破損します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일은 Tilde가 완전히 읽을 수 없는 인코딩을 사용하므로, 저장하면 파일이 손상됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件使用了 Tilde 无法完整读取的编码，保存会损坏文件。"
          }
        }
      }
    },
    "Tilde opens text files only. Images, PDFs, and other binary files can't be edited." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilde で開けるのはテキストファイルだけです。画像、PDF などのバイナリファイルは編集できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilde는 텍스트 파일만 열 수 있습니다. 이미지, PDF 등 바이너리 파일은 편집할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilde 只能打开文本文件。图像、PDF 等二进制文件无法编辑。"
          }
        }
      }
    },
    "Unsupported text encoding — opened read-only to protect the file." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応していないテキストエンコーディングです。ファイルを保護するため、読み出し専用で開いています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원하지 않는 텍스트 인코딩입니다. 파일을 보호하기 위해 읽기 전용으로 열었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持的文本编码。为保护文件，已以只读方式打开。"
          }
        }
      }
    },
    "Word Wrap" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストを折り返す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 줄바꿈"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动换行"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
